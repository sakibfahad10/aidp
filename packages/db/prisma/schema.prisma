generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------
// Enums
// --------------------------------------------------

enum InputType {
  symptom
  structured
  report
}

enum RiskLevel {
  low
  moderate
  high
  critical
}

enum Role {
  PATIENT
  DOCTOR
}

// --------------------------------------------------
// Models
// --------------------------------------------------

/// Stores each AI prediction with its input and response
model Prediction {
  id           String    @id @default(uuid())
  inputType    InputType
  inputPayload Json      // Raw input payload as JSON
  result       Json      // AI response stored as JSON
  riskLevel    RiskLevel
  summary      String
  userId       String?   // Stubbed for future auth integration
  user         User?     @relation(fields: [userId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([createdAt])
  @@index([riskLevel])
  @@index([inputType])
  @@index([userId])
}

model User {
  id          String       @id
  email       String       @unique
  name        String?
  /// Nullable so the role gate can detect users who haven't chosen yet —
  /// PATIENT is the semantic default exposed through `DEFAULT_ROLE` in
  /// `@disease-prediction/shared`, applied by the gate / webhook, not by SQL.
  role        Role?
  predictions Prediction[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
