generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------
// Enums
// --------------------------------------------------

enum InputType {
  symptom
  structured
  report
}

enum RiskLevel {
  low
  moderate
  high
  critical
}

enum Role {
  PATIENT
  DOCTOR
}

/// Mirrors `Specialty` in `@disease-prediction/shared`. `GeneralMedicine` is
/// the controlled-vocabulary fallback used when a prediction maps to nothing
/// else (see ADR 0003).
enum Specialty {
  GeneralMedicine
  Cardiology
  Endocrinology
  Dermatology
  Gastroenterology
  Neurology
  Pulmonology
  Nephrology
  Orthopedics
  Rheumatology
  Pediatrics
  Psychiatry
  Gynecology
  ENT
  Ophthalmology
  Urology
  InfectiousDisease
  GeneralSurgery
}

enum City {
  Dhaka
  Chattogram
  Sylhet
  Rajshahi
  Khulna
  Barishal
  Rangpur
  Mymensingh
}

/// Lifecycle status for `DoctorProfile`. MVP transitions `draft → verified`
/// directly on submit; `pending` is reserved for a future admin-review step
/// and is currently unused.
enum DoctorStatus {
  draft
  pending
  verified
}

/// Lifecycle status for a concrete `AvailabilitySlot`. `open` rows are
/// bookable; `booked` rows are locked to an `Appointment` (added in a later
/// slice) and can no longer be removed by the editor.
enum SlotStatus {
  open
  booked
}

// --------------------------------------------------
// Models
// --------------------------------------------------

/// Stores each AI prediction with its input and response
model Prediction {
  id           String    @id @default(uuid())
  inputType    InputType
  inputPayload Json      // Raw input payload as JSON
  result       Json      // AI response stored as JSON
  riskLevel    RiskLevel
  summary      String
  userId       String?   // Stubbed for future auth integration
  user         User?     @relation(fields: [userId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([createdAt])
  @@index([riskLevel])
  @@index([inputType])
  @@index([userId])
}

model User {
  id            String         @id
  email         String         @unique
  name          String?
  /// Nullable so the role gate can detect users who haven't chosen yet —
  /// PATIENT is the semantic default exposed through `DEFAULT_ROLE` in
  /// `@disease-prediction/shared`, applied by the gate / webhook, not by SQL.
  role          Role?
  /// Additive flag: a DOCTOR can opt in to also being a patient (their own
  /// HealthProfile, predictions, bookings) without losing the doctor side.
  /// For role=PATIENT this is true (set on initial role assignment); for
  /// role=DOCTOR it stays false until they hit "register as a patient".
  patientCapability Boolean   @default(false)
  predictions   Prediction[]
  doctorProfile DoctorProfile?
  healthProfile HealthProfile?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

/// One-per-user professional profile for doctors. Created as `draft` on first
/// onboarding step, flipped to `verified` on submit (no admin review in the
/// MVP). BMDC is `@unique` so two profiles can't claim the same registration.
model DoctorProfile {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id])
  phone           String?
  publicEmail     String?
  bmdcNumber      String?            @unique
  qualifications  String?
  specialties     Specialty[]
  affiliation     String?
  city            City?
  experienceYears Int?
  feeBdt          Int?
  status          DoctorStatus       @default(draft)
  slots           AvailabilitySlot[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([city])
}

/// Concrete, bookable time slot owned by a `DoctorProfile`. The availability
/// editor materializes one row per toggled grid cell (no recurrence: every
/// slot is an explicit row). `(doctorId, startTime)` is `@unique` so toggling
/// the same cell twice cannot create duplicates. Slots stay removable while
/// `open`; once `booked` by an `Appointment` they are locked.
model AvailabilitySlot {
  id        String        @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startTime DateTime
  status    SlotStatus    @default(open)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([doctorId, startTime])
  @@index([doctorId, status, startTime])
}

/// Patient's persistent standing health record (one per user).
/// Auto-filled from `structured` predictions via the edited-field-aware merge
/// and directly editable through `/profile`. Stores `age` (not `dateOfBirth`)
/// so auto-fill from a prediction is lossless. `editedFields` records field
/// names the patient manually edited so future auto-fills skip them.
model HealthProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age           Int?
  gender        String?
  bloodType     String?
  conditions    String[] @default([])
  medications   String[] @default([])
  allergies     String[] @default([])
  editedFields  String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
