generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------
// Enums
// --------------------------------------------------

enum InputType {
  symptom
  structured
  report
}

enum RiskLevel {
  low
  moderate
  high
  critical
}

enum Role {
  PATIENT
  DOCTOR
}

/// Mirrors `Specialty` in `@disease-prediction/shared`. `GeneralMedicine` is
/// the controlled-vocabulary fallback used when a prediction maps to nothing
/// else (see ADR 0003).
enum Specialty {
  GeneralMedicine
  Cardiology
  Endocrinology
  Dermatology
  Gastroenterology
  Neurology
  Pulmonology
  Nephrology
  Orthopedics
  Rheumatology
  Pediatrics
  Psychiatry
  Gynecology
  ENT
  Ophthalmology
  Urology
  InfectiousDisease
  GeneralSurgery
}

enum City {
  Dhaka
  Chattogram
  Sylhet
  Rajshahi
  Khulna
  Barishal
  Rangpur
  Mymensingh
}

/// Lifecycle status for `DoctorProfile`. MVP transitions `draft → verified`
/// directly on submit; `pending` is reserved for a future admin-review step
/// and is currently unused.
enum DoctorStatus {
  draft
  pending
  verified
}

// --------------------------------------------------
// Models
// --------------------------------------------------

/// Stores each AI prediction with its input and response
model Prediction {
  id           String    @id @default(uuid())
  inputType    InputType
  inputPayload Json      // Raw input payload as JSON
  result       Json      // AI response stored as JSON
  riskLevel    RiskLevel
  summary      String
  userId       String?   // Stubbed for future auth integration
  user         User?     @relation(fields: [userId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([createdAt])
  @@index([riskLevel])
  @@index([inputType])
  @@index([userId])
}

model User {
  id            String         @id
  email         String         @unique
  name          String?
  /// Nullable so the role gate can detect users who haven't chosen yet —
  /// PATIENT is the semantic default exposed through `DEFAULT_ROLE` in
  /// `@disease-prediction/shared`, applied by the gate / webhook, not by SQL.
  role          Role?
  predictions   Prediction[]
  doctorProfile DoctorProfile?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

/// One-per-user professional profile for doctors. Created as `draft` on first
/// onboarding step, flipped to `verified` on submit (no admin review in the
/// MVP). BMDC is `@unique` so two profiles can't claim the same registration.
model DoctorProfile {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id])
  phone           String?
  publicEmail     String?
  bmdcNumber      String?      @unique
  qualifications  String?
  specialties     Specialty[]
  affiliation     String?
  city            City?
  experienceYears Int?
  feeBdt          Int?
  status          DoctorStatus @default(draft)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
  @@index([city])
}
